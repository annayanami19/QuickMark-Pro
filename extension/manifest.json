{
  "manifest_version": 3,
  "name": "QuickMark Pro",
  "version": "1.0.0",
  "description": "Bookmark manager cepat: quick save 1-klik, fuzzy search, kategori otomatis offline, dan multi-profil (work/personal).",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "QuickMark Pro — simpan & cari bookmark",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "panel/panel.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/quick-panel.js"],
      "css": ["content/quick-panel.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background/sw.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "bookmarks",
    "favicon",
    "sidePanel",
    "alarms",
    "activeTab",
    "identity"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "YOUR_CLIENT_ID.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/drive.file"]
  },
  "omnibox": {
    "keyword": "qm"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Buka QuickMark Pro (popup)"
    },
    "quick-save": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Simpan halaman aktif ke profil aktif"
    }
  }
}
